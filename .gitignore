# Python bytecode and optional local tooling caches
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Workspace runtime state (sessions, telemetry and benchmark results)
.sudarshan/
.sudarshan-memory.lock
.sudarshan-memory-*
/work/
/projects/

# Local credentials; never commit their contents
.env
.env/
.env.*
*.pem
*.key
credentials.json
service-account*.json
id_rsa
id_ed25519

# Known generated validation output and test workspaces
/tests/tmp*/

/ci-results/
/*.log
/benchmark-results/
/benchmark-exports/

# Editor/OS metadata and temporary editor files
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*~
*.swp
*.swo

# Local Python package build outputs
/dist/
/build/
*.egg-info/
/.package-test/
